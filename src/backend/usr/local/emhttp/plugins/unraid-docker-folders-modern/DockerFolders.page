<script>
function saveSetting(key, value) {
  var statusEl = document.getElementById('save-status-' + key.replace(/_/g, '-'));
  var csrfToken = (typeof window.csrf_token === 'string') ? window.csrf_token : '';
  var body = 'csrf_token=' + encodeURIComponent(csrfToken) + '&payload=' + encodeURIComponent(JSON.stringify({key: key, value: value}));

  var xhr = new XMLHttpRequest();
  xhr.open('POST', '/plugins/unraid-docker-folders-modern/api/settings.php', true);
  xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
  xhr.onload = function() {
    var error = null;
    if (xhr.status >= 400) {
      try { error = JSON.parse(xhr.responseText).message; } catch (e) {}
      error = error || ('未保存（HTTP ' + xhr.status + ')');
    }
    showSaveStatus(statusEl, error);
  };
  xhr.onerror = function() { showSaveStatus(statusEl, '未保存：服务器无响应'); };
  xhr.send(body);
}

// "已保存" for 2 seconds, or the server's error for 8.
function showSaveStatus(statusEl, error) {
  if (!statusEl) return;
  clearTimeout(statusEl.hideTimer);
  statusEl.textContent = error || '已保存';
  statusEl.classList.toggle('failed', !!error);
  statusEl.classList.add('visible');
  statusEl.hideTimer = setTimeout(function() { statusEl.classList.remove('visible'); }, error ? 8000 : 2000);
}

// --- Backend switch ---
//
// Switching installs or removes the GraphQL backend in the Unraid API, which
// restarts the API, so settings.php starts it in the background and this polls
// its state file. GraphQL is stored only once the backend answers.

var BACKEND_ROLLBACK_COMMAND = 'bash /usr/local/emhttp/plugins/unraid-docker-folders-modern/scripts/api-plugin.sh rollback';

// Plain text the user copies before the install button unlocks. Keep it in
// step with the list in BACKEND_WARNING.
var BACKEND_RESTORE_TEXT =
  'Docker Folders: how to go back from the GraphQL backend to PHP, in this order.\n' +
  '1. On Settings > Docker Folders, set the data source to PHP.\n' +
  '2. If the webgui does not respond, run this over SSH or on the local console:\n' +
  '   ' + BACKEND_ROLLBACK_COMMAND + '\n' +
  '3. If that fails, remove the Docker Folders plugin on the Plugins page, or run:\n' +
  '   plugin remove unraid-docker-folders-modern.plg\n' +
  '   The removal also takes the backend out of the Unraid API, and your folders are kept in a database backup.\n';

var BACKEND_WARNING =
  '<div style="text-align:left">' +
  '<p>GraphQL 后端为 <b>highly experimental</b>.</p>' +
  '<p>It installs code into the Unraid API. A fault in that code can take the whole Unraid GraphQL service offline, and the dashboard and other parts of the webgui use that service. The Unraid API restarts now, and is offline for about 15 seconds.</p>' +
  '<p>If the backend stops answering for about 8 minutes while the Unraid API runs, the plugin switches back to PHP by itself and sends a notification.</p>' +
  '<div style="border:1px solid #e68a00;background:color-mix(in srgb, #e68a00 12%, transparent);border-radius:4px;padding:8px 10px;margin:10px 0">' +
  '<b>不要依赖自动恢复。</b> 它可能失败，也可能来得太晚。在安装前，请复制以下步骤并保存在 WebGUI 之外。</div>' +
  '<p>如需手动恢复，请按以下顺序：</p>' +
  '<ol style="margin-left:20px">' +
  '<li>在此页面，将数据源设置为 PHP。</li>' +
  '<li>如果 WebGUI 无响应，请通过 SSH 或本地控制台运行：<br>' +
  '<code>' + BACKEND_ROLLBACK_COMMAND + '</code></li>' +
  '<li>如果失败，请在插件页面移除 Docker 文件夹插件，或运行 <code>plugin remove unraid-docker-folders-modern.plg</code>。移除操作还会将该后端从 Unraid API 中卸下，而你的文件夹会保留在数据库备份中。</li>' +
  '</ol>' +
  '<p style="margin-top:10px"><button type="button" id="backend-copy-restore">复制恢复步骤</button> ' +
  '<span id="backend-copy-status">复制这些步骤以解锁安装按钮。</span></p>' +
  '<textarea id="backend-restore-text" readonly rows="6" style="display:none;width:100%;font-family:monospace;font-size:12px"></textarea>' +
  '</div>';

// SweetAlert reuses one dialog element, so undo what the warning added to it.
function resetBackendWarningDialog() {
  var confirmButton = document.querySelector('.sweet-alert button.confirm');
  if (confirmButton) confirmButton.disabled = false;
  var note = document.getElementById('backend-no-support');
  if (note) note.parentNode.removeChild(note);
}

// Disables the install button until the restore steps are copied, and puts
// the no-support note under it. Returns a function that reports whether the
// copy happened.
function armBackendWarningDialog() {
  var copied = false;
  var confirmButton = document.querySelector('.sweet-alert button.confirm');
  var buttons = document.querySelector('.sweet-alert .sa-button-container');
  var copyButton = document.getElementById('backend-copy-restore');
  var status = document.getElementById('backend-copy-status');
  var area = document.getElementById('backend-restore-text');

  if (confirmButton) confirmButton.disabled = true;
  if (buttons && !document.getElementById('backend-no-support')) {
    var note = document.createElement('p');
    note.id = 'backend-no-support';
    note.style.cssText = 'font-size:12px;margin:10px 0 0;opacity:0.8';
    note.textContent = 'If you install regardless of this warning, the GraphQL backend comes with no support.';
    buttons.parentNode.insertBefore(note, buttons.nextSibling);
  }
  area.value = BACKEND_RESTORE_TEXT;

  function markCopied() {
    copied = true;
    if (confirmButton) confirmButton.disabled = false;
    status.textContent = 'Copied. Keep the steps somewhere outside the webgui.';
  }

  // A manual copy from the fallback text box counts too.
  area.addEventListener('copy', markCopied);

  // The clipboard API needs HTTPS, and Unraid often serves plain HTTP. Fall
  // back to execCommand, and then to a text box the user copies by hand.
  function copyWithSelection() {
    area.style.display = 'block';
    area.focus();
    area.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    if (!ok) status.textContent = 'Copy failed. Select the text below and copy it by hand.';
  }

  // swal() sets its own handlers on every <button> in the dialog, and a click
  // on any button but Confirm counts as Cancel and closes the dialog. Take
  // them off the copy button. See handleButton in dynamix.js.
  ['onclick', 'onmouseover', 'onmouseout', 'onmousedown', 'onmouseup', 'onfocus'].forEach(function(handler) {
    copyButton[handler] = null;
  });

  copyButton.addEventListener('click', function() {
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(BACKEND_RESTORE_TEXT).then(markCopied, copyWithSelection);
    } else {
      copyWithSelection();
    }
  });

  return function() { return copied; };
}

function changeBackendMode(select) {
  var previous = select.getAttribute('data-current') || 'php';
  var mode = select.value;
  if (mode === previous) return;

  if (mode !== 'graphql') {
    startBackendSwitch(select, mode, 'Removing the GraphQL backend. The Unraid API restarts for about 15 seconds.');
    return;
  }

  // Show the stored mode until the user confirms, so a dialog that closes
  // without a callback leaves the select telling the truth.
  select.value = previous;
  var hasCopiedRestore = function() { return false; };
  swal({
    title: 'Switch to the GraphQL backend?',
    text: BACKEND_WARNING,
    type: 'warning',
    html: true,
    showCancelButton: true,
    confirmButtonText: 'Install and switch',
    cancelButtonText: '取消'
  }, function(confirmed) {
    var restoreCopied = hasCopiedRestore();
    resetBackendWarningDialog();
    if (!confirmed || !restoreCopied) {
      select.value = previous;
      return;
    }
    select.value = mode;
    startBackendSwitch(select, mode, 'Installing the GraphQL backend. The Unraid API restarts for about 15 seconds.');
  });
  // swal() builds the dialog synchronously, so its buttons exist now.
  hasCopiedRestore = armBackendWarningDialog();
}

function startBackendSwitch(select, mode, message) {
  var progress = document.getElementById('backend-mode-progress');
  var csrfToken = (typeof window.csrf_token === 'string') ? window.csrf_token : '';
  var body = 'csrf_token=' + encodeURIComponent(csrfToken) + '&payload=' + encodeURIComponent(JSON.stringify({key: 'backend_mode', value: mode}));
  select.disabled = true;
  progress.textContent = message;

  var xhr = new XMLHttpRequest();
  xhr.open('POST', '/plugins/unraid-docker-folders-modern/api/settings.php', true);
  xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
  xhr.onload = function() {
    var result = null;
    try { result = JSON.parse(xhr.responseText); } catch (e) { result = null; }
    if (!result || !result.success) {
      var why = (result && result.message) ? result.message : 'the server did not accept it.';
      finishBackendSwitch(select, select.getAttribute('data-current') || 'php', 'The switch failed: ' + why);
      return;
    }
    setTimeout(function() { pollBackendStatus(select, mode, result.run, 0); }, 2000);
  };
  xhr.onerror = function() {
    finishBackendSwitch(select, select.getAttribute('data-current') || 'php', 'The switch failed: the server did not answer.');
  };
  xhr.send(body);
}

function pollBackendStatus(select, mode, run, attempt) {
  var progress = document.getElementById('backend-mode-progress');
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/plugins/unraid-docker-folders-modern/api/settings.php?action=backend-status', true);
  xhr.onload = function() {
    var status = null;
    try { status = JSON.parse(xhr.responseText); } catch (e) { status = null; }
    var plugin = status && status.plugin;
    // Boot and watchdog runs write the same file. Only this click's run counts.
    var current = plugin && plugin.run === run;
    var done = current && ['ready', 'installed', 'failed', 'removed'].indexOf(plugin.state) !== -1;
    if (!done) {
      if (attempt >= 150) {
        finishBackendSwitch(select, status ? status.mode : 'php', 'No answer after 5 minutes. See /boot/config/plugins/unraid-docker-folders-modern/install.log.');
        return;
      }
      setTimeout(function() { pollBackendStatus(select, mode, run, attempt + 1); }, 2000);
      return;
    }
    if (plugin.state === 'failed') {
      finishBackendSwitch(select, status.mode, 'The switch failed: ' + plugin.reason + ' The data source is ' + (status.mode === 'graphql' ? 'GraphQL.' : 'PHP.'));
    } else if (mode === 'graphql') {
      finishBackendSwitch(select, status.mode, status.mode === 'graphql' ? 'GraphQL is on. Reload the Folders page.' : 'The backend installed, but the data source is still PHP.');
    } else {
      finishBackendSwitch(select, status.mode, 'PHP is on, and the GraphQL backend is removed. Reload the Folders page.');
    }
  };
  // The API restart can drop a request. Keep polling.
  xhr.onerror = function() { setTimeout(function() { pollBackendStatus(select, mode, run, attempt + 1); }, 2000); };
  xhr.send();
}

function finishBackendSwitch(select, mode, message) {
  select.value = mode;
  select.setAttribute('data-current', mode);
  select.disabled = false;
  document.getElementById('backend-mode-progress').textContent = message;
}

function toggleUpdateSettings(enabled) {
  saveSetting('enable_update_checks', enabled ? '1' : '0');
  var section = document.getElementById('update-settings');
  if (section) {
    if (enabled) {
      section.classList.remove('hidden');
    } else {
      section.classList.add('hidden');
      // Reset schedule to disabled when turning off update checks
      var scheduleEl = document.getElementById('update-check-schedule');
      if (scheduleEl) scheduleEl.value = 'disabled';
    }
  }
}

// --- Exclude Modal ---

var excludeModalImages = []; // { image, containers[] }
var excludeChecked = new Set();
var excludeCustom = [];

function getCurrentExclusions() {
  // Parse from the PHP-provided value
  var raw = <?= json_encode($updateCheckExclude) ?>;
  return raw ? raw.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : [];
}

function isGlobPattern(str) {
  return str.indexOf('*') !== -1 || str.indexOf('?') !== -1;
}

function openExcludeModal() {
  var modal = document.getElementById('exclude-modal');
  modal.classList.add('open');

  var current = getCurrentExclusions();

  // Separate exact image names from glob patterns
  excludeCustom = current.filter(isGlobPattern);
  var exactExcludes = new Set(current.filter(function(p) { return !isGlobPattern(p); }));

  excludeChecked = exactExcludes;
  renderCustomTags();

  // Fetch containers
  var csrfToken = (typeof window.csrf_token === 'string') ? window.csrf_token : '';
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/plugins/unraid-docker-folders-modern/api/containers.php', true);
  xhr.onload = function() {
    try {
      var data = JSON.parse(xhr.responseText);
      var containers = data.containers || [];

      // Group by image
      var imageMap = {};
      containers.forEach(function(c) {
        if (!imageMap[c.image]) {
          imageMap[c.image] = [];
        }
        imageMap[c.image].push(c.name);
      });

      excludeModalImages = Object.keys(imageMap).sort().map(function(image) {
        return { image: image, containers: imageMap[image] };
      });

      // Pre-check images that match current exclusions (including glob)
      excludeModalImages.forEach(function(item) {
        if (exactExcludes.has(item.image)) {
          excludeChecked.add(item.image);
        } else {
          // Check if any glob pattern matches
          for (var i = 0; i < excludeCustom.length; i++) {
            if (globMatch(excludeCustom[i], item.image)) {
              excludeChecked.add(item.image);
              break;
            }
          }
        }
      });

      renderExcludeList();
    } catch (e) {
      document.getElementById('exclude-list').innerHTML = '<div class="exclude-empty">加载容器失败</div>';
    }
  };
  xhr.onerror = function() {
    document.getElementById('exclude-list').innerHTML = '<div class="exclude-empty">加载容器失败</div>';
  };
  xhr.send();
}

function closeExcludeModal() {
  document.getElementById('exclude-modal').classList.remove('open');
  document.getElementById('exclude-search').value = '';
}

function globMatch(pattern, str) {
  var regex = new RegExp('^' + pattern.replace(/[.+^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*?').replace(/\?/g, '.') + '$');
  return regex.test(str);
}

function renderExcludeList() {
  var list = document.getElementById('exclude-list');
  var search = document.getElementById('exclude-search').value.toLowerCase();

  var filtered = excludeModalImages.filter(function(item) {
    if (!search) return true;
    return item.image.toLowerCase().indexOf(search) !== -1 ||
           item.containers.some(function(c) { return c.toLowerCase().indexOf(search) !== -1; });
  });

  if (filtered.length === 0) {
    list.innerHTML = '<div class="exclude-empty">' + (search ? 'No matching images' : 'No containers found') + '</div>';
    return;
  }

  var html = '';
  filtered.forEach(function(item) {
    var checked = excludeChecked.has(item.image);
    html += '<div class="exclude-item' + (checked ? ' checked' : '') + '" onclick="toggleExclude(\'' + escapeHtml(item.image) + '\')">';
    html += '<input type="checkbox" ' + (checked ? 'checked' : '') + ' onclick="event.stopPropagation();toggleExclude(\'' + escapeHtml(item.image) + '\')" />';
    html += '<div class="exclude-item-info">';
    html += '<div class="exclude-item-image">' + escapeHtml(item.image) + '</div>';
    html += '<div class="exclude-item-containers">Used by: ' + item.containers.map(escapeHtml).join(', ') + '</div>';
    html += '</div></div>';
  });

  list.innerHTML = html;
}

function toggleExclude(image) {
  if (excludeChecked.has(image)) {
    excludeChecked.delete(image);
  } else {
    excludeChecked.add(image);
  }
  renderExcludeList();
}

function filterExcludeList() {
  renderExcludeList();
}

function addCustomPattern() {
  var input = document.getElementById('exclude-custom-input');
  var pattern = input.value.trim();
  if (!pattern) return;
  if (excludeCustom.indexOf(pattern) === -1) {
    excludeCustom.push(pattern);
    renderCustomTags();
  }
  input.value = '';
}

function removeCustomPattern(idx) {
  excludeCustom.splice(idx, 1);
  renderCustomTags();
}

function renderCustomTags() {
  var container = document.getElementById('exclude-custom-tags');
  if (excludeCustom.length === 0) {
    container.innerHTML = '';
    return;
  }
  var html = '';
  excludeCustom.forEach(function(p, i) {
    html += '<span class="exclude-tag">' + escapeHtml(p) + ' <button class="exclude-tag-remove" onclick="removeCustomPattern(' + i + ')">&times;</button></span>';
  });
  container.innerHTML = html;
}

function saveExclusions() {
  // Combine checked images + custom patterns
  var all = [];
  excludeChecked.forEach(function(image) {
    all.push(image);
  });
  excludeCustom.forEach(function(pattern) {
    if (all.indexOf(pattern) === -1) {
      all.push(pattern);
    }
  });

  var value = all.join(',');
  saveSetting('update_check_exclude', value);

  // Update the displayed count
  var countEl = document.getElementById('exclude-count');
  if (countEl) {
    countEl.textContent = all.length > 0 ? all.length + ' excluded' : 'None';
  }

  closeExcludeModal();
}

function escapeHtml(str) {
  var div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function toggleLog() {
  var viewer = document.getElementById('log-viewer');
  var arrow = document.getElementById('log-arrow');
  var clearBtn = document.getElementById('clear-log-btn');
  var isOpen = viewer.classList.toggle('open');
  arrow.classList.toggle('open', isOpen);
  if (clearBtn) clearBtn.style.display = isOpen ? '' : 'none';
  if (isOpen) {
    // Scroll to bottom to show latest entries
    var content = document.getElementById('log-content');
    content.scrollTop = content.scrollHeight;
  }
}

function clearLog() {
  var csrfToken = (typeof window.csrf_token === 'string') ? window.csrf_token : '';
  var body = 'csrf_token=' + encodeURIComponent(csrfToken) + '&payload=' + encodeURIComponent(JSON.stringify({action: 'clear_log'}));

  var xhr = new XMLHttpRequest();
  xhr.open('POST', '/plugins/unraid-docker-folders-modern/api/settings.php', true);
  xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
  xhr.onload = function() {
    try {
      var data = JSON.parse(xhr.responseText);
      if (data.success) {
        document.getElementById('log-content').innerHTML = '<span class="log-empty">暂无日志。首次计划或手动更新检查后会出现日志。</span>';
      }
    } catch (e) {}
  };
  xhr.send(body);
}

function exportComposeConfigs() {
  var statusEl = document.getElementById('export-status');
  statusEl.textContent = 'Exporting...';
  statusEl.classList.add('visible');

  var csrfToken = (typeof window.csrf_token === 'string') ? window.csrf_token : '';
  var body = 'csrf_token=' + encodeURIComponent(csrfToken);

  var xhr = new XMLHttpRequest();
  xhr.open('POST', '/plugins/unraid-docker-folders-modern/api/compose.php?action=export_configs', true);
  xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
  xhr.onload = function() {
    try {
      var data = JSON.parse(xhr.responseText);
      if (data.success) {
        statusEl.textContent = 'Exported ' + data.exported + ' stack(s) to ' + data.path;
        if (data.errors && data.errors.length > 0) {
          statusEl.textContent += ' (' + data.errors.length + ' error(s))';
        }
      } else {
        statusEl.textContent = 'Error: ' + (data.message || 'Unknown error');
      }
    } catch (e) {
      statusEl.textContent = 'Error: Invalid response';
    }
    setTimeout(function() { statusEl.classList.remove('visible'); }, 5000);
  };
  xhr.onerror = function() {
    statusEl.textContent = 'Error: Network failure';
    setTimeout(function() { statusEl.classList.remove('visible'); }, 5000);
  };
  xhr.send(body);
}

// Detect dark theme from computed background color and set color-scheme
// so native form controls (select dropdowns) render correctly
(function() {
  var el = document.querySelector('.settings-container');
  if (!el) return;
  var bg = getComputedStyle(el).backgroundColor;
  var m = bg.match(/\d+/g);
  if (m && m.length >= 3) {
    var luminance = (0.299 * +m[0] + 0.587 * +m[1] + 0.114 * +m[2]) / 255;
    if (luminance < 0.5) {
      el.style.colorScheme = 'dark';
    }
  }
})();
</script>
