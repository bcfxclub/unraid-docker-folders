<?php
require_once '/usr/local/emhttp/plugins/unraid-docker-folders-modern/include/config.php';
require_once '/usr/local/emhttp/plugins/unraid-docker-folders-modern/classes/Database.php';

$db = Database::getInstance();
$rows = $db->fetchAll('SELECT key, value FROM settings');
$settings = [];
foreach ($rows as $row) {
  $settings[$row['key']] = $row['value'];
}
$distinguishHealthy = ($settings['distinguish_healthy'] ?? '1') === '1';
$showStats = ($settings['show_stats'] ?? '1') === '1';
$memoryCalculation = ($settings['memory_calculation'] ?? '') === 'raw' ? 'raw' : 'docker';
$memoryCalculationOptions = ['docker' => 'Docker CLI (excludes page cache)', 'raw' => 'Raw cgroup (includes page cache)'];
$replaceDockerSection = ($settings['replace_docker_section'] ?? '1') === '1';
$showLegacyContainers = ($settings['show_legacy_containers'] ?? '0') === '1';
$showLegacyButtons = ($settings['show_legacy_buttons'] ?? '0') === '1';
$showFolderPorts = ($settings['show_folder_ports'] ?? '1') === '1';
$showInlineLogs = ($settings['show_inline_logs'] ?? '0') === '1';
$enableAdopt = ($settings['enable_adopt'] ?? '1') === '1';
$composeAutoInstall = ($settings['compose_auto_install'] ?? '0') === '1';
$confirmStackDown = ($settings['confirm_stack_down'] ?? '1') === '1';
$confirmRecompose = ($settings['confirm_recompose'] ?? '1') === '1';
$enableSecurityAdvisor = ($settings['enable_security_advisor'] ?? '1') === '1';
$logRefreshInterval = $settings['log_refresh_interval'] ?? '10';
$statsRefreshInterval = $settings['stats_refresh_interval'] ?? '2';
$statsRefreshOptions = ['1' => '1 second', '2' => '2 秒', '5' => '5 秒', '10' => '10 seconds', '15' => '15 秒', '30' => '30 秒', '60' => '60 秒'];
$backendMode = dfmNormalizeBackendMode($settings['backend_mode'] ?? 'php');
$graphqlPluginState = dfmGraphqlPluginState();
// Choosing GraphQL installs the backend, so it only needs a running Unraid
// API. A stored 'graphql' still shows, so a user who lost the API can see why
// the page fell back to PHP.
// It also needs an API version the backend is tested on.
$unraidApiVersion = dfmUnraidApiVersion();
$apiVersionReason = $graphqlPluginState === 'no-api' ? '' : dfmApiVersionReason($unraidApiVersion, dfmApiCompatRange());
$graphqlSelectable = ($graphqlPluginState !== 'no-api' && $apiVersionReason === '') || $backendMode === 'graphql';
$graphqlUnavailableReason = [
  'no-api' => 'The Unraid API is not running on this system. It ships with Unraid 7.2 and later.',
][$graphqlPluginState] ?? $apiVersionReason;
// Set when the backend watchdog switched this server back to PHP.
$backendRollback = $backendMode === 'php' ? dfmReadJsonFile(DFM_BACKEND_ROLLBACK_MARKER) : null;
$enableUpdateChecks = ($settings['enable_update_checks'] ?? '0') === '1';
$updateCheckSchedule = $settings['update_check_schedule'] ?? 'disabled';
$notifyOnUpdates = ($settings['notify_on_updates'] ?? '0') === '1';
$updateCheckExclude = $settings['update_check_exclude'] ?? '';
$postPullAction = $settings['post_pull_action'] ?? 'pull_only';
$updateConcurrency = (int) ($settings['update_concurrency'] ?? 3);
if ($updateConcurrency < 1 || $updateConcurrency > 5) {
  $updateConcurrency = 3;
}
$composeExportDir = $settings['compose_export_dir'] ?? COMPOSE_STACKS_DIR;

// Count excluded images for display
$excludeCount = 0;
if (!empty($updateCheckExclude)) {
  $excludeCount = count(array_filter(array_map('trim', explode(',', $updateCheckExclude)), function($p) { return $p !== ''; }));
}

// Read update check log (last 100 lines)
$updateLog = '';
$updateLogPath = CONFIG_DIR . '/update-check.log';
if (file_exists($updateLogPath)) {
  $lines = file($updateLogPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
  $lines = array_slice($lines, -100);
  $updateLog = implode("\n", $lines);
}

// Parse CHANGELOG.md — extract the latest version section
$changelogHtml = '';
$changelogPath = PLUGIN_DIR . '/CHANGELOG.md';
if (file_exists($changelogPath)) {
  $lines = file($changelogPath, FILE_IGNORE_NEW_LINES);
  $inLatest = false;
  $sections = [];
  $currentSection = '';
  $currentItems = [];

  foreach ($lines as $line) {
    // Skip the "# Changelog" title
    if (preg_match('/^# /', $line)) continue;

    // "## version" — start of a version block
    if (preg_match('/^## (.+)/', $line, $m)) {
      if ($inLatest) break; // stop at second version heading
      $inLatest = true;
      $changelogVersion = trim($m[1]);
      continue;
    }

    if (!$inLatest) continue;

    // "### Section" heading
    if (preg_match('/^### (.+)/', $line, $m)) {
      if ($currentSection && $currentItems) {
        $sections[] = ['title' => $currentSection, 'items' => $currentItems];
      }
      $currentSection = trim($m[1]);
      $currentItems = [];
      continue;
    }

    // "- item" list entry
    if (preg_match('/^- (.+)/', $line, $m)) {
      $currentItems[] = htmlspecialchars(trim($m[1]));
    }
  }

  if ($currentSection && $currentItems) {
    $sections[] = ['title' => $currentSection, 'items' => $currentItems];
  }

  if ($sections) {
    $changelogHtml .= '<h3 class="changelog-title">Latest Changes &mdash; ' . htmlspecialchars($changelogVersion ?? '') . '</h3>';
    foreach ($sections as $sec) {
      $changelogHtml .= '<p class="changelog-section">' . htmlspecialchars($sec['title']) . '</p><ul class="changelog-list">';
      foreach ($sec['items'] as $item) {
        $changelogHtml .= '<li>' . $item . '</li>';
      }
      $changelogHtml .= '</ul>';
    }
  }
}
?>

